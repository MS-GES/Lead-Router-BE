# ==============================================================================
# Privyr Webhook & Lead Router Environment Configuration
# ==============================================================================

# Privyr Webhook Authentication (Bearer Token)
PRIVYR_WEBHOOK_SECRET=your_privyr_webhook_bearer_token_here

# Google Gemini AI Configuration
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Liquid AI Configuration (Used for lead template decision)
LIQUID_API_KEY=your_liquid_ai_api_key_here
LIQUID_MODEL=d1

# SMTP / Email Server Configuration (e.g., Gmail SMTP or custom provider)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_app_specific_password_here
SMTP_USE_TLS=true
DEFAULT_SENDER_EMAIL=your_email@example.com

# Notification Recipients
# The internal email address where AI-drafted lead notifications are routed
IT_TEAM_EMAIL=team_notifications@example.com
# BD Team email address notified when a lead has a missing/empty email address
BD_TEAM_EMAIL=bd_notifications@example.com
